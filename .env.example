# ============================================================
# Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# CRM Integration
# Get your HubSpot token from: Settings → Integrations → Private Apps
# Scopes needed: crm.objects.contacts.read/write, crm.objects.companies.read/write
# ------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token-here

# ------------------------------------------------------------
# AI Review (Claude)
# Get your key from: console.anthropic.com
# Used by the review queue AI — keep this separate from your Claude Code key
# to avoid rate limit conflicts
# ------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ------------------------------------------------------------
# Slack Notifications (optional)
# Get your bot token from: api.slack.com → Your Apps → OAuth & Permissions
# Scopes needed: chat:write, channels:read
# Leave blank to have digests print to stdout instead
# ------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_REVIEW_CHANNEL=#hubspot-dedup-review

# ------------------------------------------------------------
# Database
# Path to the SQLite database file. Default is fine for most setups.
# ------------------------------------------------------------
DB_PATH=./dedup.db

# ------------------------------------------------------------
# Live mode (for scheduled/automated runs)
# Set to "true" to enable live merges in scheduled agent runs.
# Omit or set to "false" for dry-run mode (safe default).
# ------------------------------------------------------------
DEDUP_LIVE=true
